# Azure OpenAI 키. settings.yaml의 ${GRAPHRAG_API_KEY}와 exp5_llm.py가 모두 이 변수를 읽는다.
# .env.example을 .env로 복사한 뒤 값 채워서 사용. .env는 .gitignore로 커밋 막혀 있음.
GRAPHRAG_API_KEY=
GRAPHRAG_API_BASE=https://your-resource.openai.azure.com/

# ---------------------------------------------------------------------------
# 전처리 파이프라인 (preprocessing/pipeline_v2.py) 전용 자격증명.
# graphrag 키와는 별개 체계다. preprocessing 코드는 repo 루트의 이 .env를 읽는다.
# 디지털 PDF의 결정적 단계(STEP1/STEP2-MU)만 돌릴 때는 아래 값이 없어도 된다.
# ---------------------------------------------------------------------------

# Azure Content Understanding (스캔 PDF용 STEP2-CU에서만 필요)
CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_KEY=
# 선택: 미설정 시 코드 기본값(2025-11-01) 사용
CONTENT_UNDERSTANDING_API_VER=

# Azure OpenAI (LLM 정제 STEP5에서 필요)
OPEN_AI_ENDPOINT=
OPEN_AI_KEY=
OPEN_AI_DEPLOYMENT_NAME_4.1_MINI=
# 선택: 디지털 PDF 캡션 생성(Vision)에만 사용
OPEN_AI_DEPLOYMENT_NAME_4O=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
